# caseGuide Server Environment Configuration

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/caseguide

# JWT Secret for Session Authentication
JWT_SECRET=caseguide_dev_secret_key_change_in_production_982347

# NVIDIA NIM API Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
ENABLE_THINKING=false

# FastAPI RAG AI Microservice
AI_SERVICE_URL=https://caseguide-fastapi-backend.onrender.com
AI_SERVICE_TIMEOUT_MS=60000
AI_SERVICE_API_KEY=
ADMIN_API_KEY=caseguide_admin_secret_key

# Development / Offline Mock Mode (true enables full mock responses without external calls)
MOCK_LLM=true
